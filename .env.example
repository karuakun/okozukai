# API 設定
# 開発時は Azurite（Azure Storage エミュレーター）を使用
AZURE_STORAGE_CONNECTION_STRING=UseDevelopmentStorage=true

# 認証 (Auth0 を想定。Azure AD B2C / Firebase も同様に設定)
# Auth0 Domain: https://manage.auth0.com/ で作成
AUTH_AUTHORITY=https://YOUR_DOMAIN.auth0.com/
AUTH_AUDIENCE=https://okozukai-api

# Auth0 SPA アプリケーション設定 (Blazor / CLI)
AUTH0_CLIENT_ID=your_client_id_here

# CORS許可オリジン（カンマ区切り）
CORS_ORIGINS=https://localhost:7200,http://localhost:5200
