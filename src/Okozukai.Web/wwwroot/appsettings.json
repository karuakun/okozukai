{
  "Api": {
    "BaseUrl": "https://localhost:7100"
  },
  "Auth": {
    "Oidc": {
      "Authority": "https://YOUR_AUTH0_DOMAIN/",
      "ClientId": "YOUR_AUTH0_CLIENT_ID",
      "DefaultScopes": [
        "openid",
        "profile",
        "email"
      ],
      "PostLogoutRedirectUri": "https://localhost:7200/authentication/logout-callback",
      "RedirectUri": "https://localhost:7200/authentication/login-callback"
    }
  }
}
